start: query ";"? | "```" /(?i:sql)?/ query ";"? "```"
query: with_clause? select_core (compound select_core)* order_clause? limit_clause?
with_clause: "WITH"i "RECURSIVE"i? cte ("," cte)*
cte: ident ("(" ident ("," ident)* ")")? "AS"i ("NOT"i? "MATERIALIZED"i)? "(" query ")"
compound: "UNION"i "ALL"i? | "INTERSECT"i | "EXCEPT"i
select_core: "SELECT"i ("DISTINCT"i | "ALL"i)? result ("," result)* from_clause? where_clause? group_clause? window_clause?
result: "*" | ident "." "*" | expr ("AS"i? ident)?
from_clause: "FROM"i source ("," source | join)*
source: table_name ("AS"i? ident)? | "(" query ")" ("AS"i? ident)? | "(" source ("," source | join)* ")" ("AS"i? ident)?
table_name: ident ("." ident)?
join: ("NATURAL"i? ("LEFT"i "OUTER"i? | "RIGHT"i "OUTER"i? | "FULL"i "OUTER"i? | "INNER"i | "CROSS"i)?) "JOIN"i source join_condition?
join_condition: "ON"i expr | "USING"i "(" ident ("," ident)* ")"
where_clause: "WHERE"i expr
group_clause: "GROUP"i "BY"i expr ("," expr)* ("HAVING"i expr)?
order_clause: "ORDER"i "BY"i order_term ("," order_term)*
order_term: expr ("ASC"i | "DESC"i)? ("NULLS"i ("FIRST"i | "LAST"i))?
limit_clause: "LIMIT"i expr (("OFFSET"i | ",") expr)?
window_clause: "WINDOW"i ident "AS"i window_spec ("," ident "AS"i window_spec)*
window_spec: "(" ident? ("PARTITION"i "BY"i expr ("," expr)*)? order_clause? frame? ")"
frame: ("RANGE"i | "ROWS"i | "GROUPS"i) (frame_bound | "BETWEEN"i frame_bound "AND"i frame_bound) ("EXCLUDE"i ("NO"i "OTHERS"i | "CURRENT"i "ROW"i | "GROUP"i | "TIES"i))?
frame_bound: "UNBOUNDED"i ("PRECEDING"i | "FOLLOWING"i) | "CURRENT"i "ROW"i | expr ("PRECEDING"i | "FOLLOWING"i)
?expr: or_expr
?or_expr: and_expr ("OR"i and_expr)*
?and_expr: not_expr ("AND"i not_expr)*
?not_expr: "NOT"i not_expr | comparison
?comparison: bit_expr (compare_op bit_expr | "IS"i "NOT"i? ("DISTINCT"i "FROM"i)? bit_expr | "NOT"i? "BETWEEN"i bit_expr "AND"i bit_expr | "NOT"i? "IN"i "(" (query | expr ("," expr)*)? ")" | "NOT"i? ("LIKE"i | "GLOB"i | "MATCH"i | "REGEXP"i) bit_expr ("ESCAPE"i bit_expr)? | "ISNULL"i | "NOTNULL"i | "NOT"i "NULL"i)*
compare_op: "=" | "==" | "!=" | "<>" | "<=" | ">=" | "<" | ">"
?bit_expr: sum_expr (("&" | "|" | "<<" | ">>") sum_expr)*
?sum_expr: product (("+" | "-") product)*
?product: concat (("*" | "/" | "%") concat)*
?concat: unary (("||" | "->" | "->>") unary)*
?unary: ("+" | "-" | "~") unary | atom ("COLLATE"i ident)*
?atom: literal | column | function | "(" (query | expr ("," expr)*) ")" | "EXISTS"i "(" query ")" | case_expr | cast_expr
column: ident ("." ident){0,2}
function: ident "(" ("*" | "DISTINCT"i? expr ("," expr)* order_clause?)? ")" ("FILTER"i "(" "WHERE"i expr ")")? ("OVER"i (ident | window_spec))?
cast_expr: "CAST"i "(" expr "AS"i ident ident? ("(" NUMBER ("," NUMBER)? ")")? ")"
case_expr: "CASE"i expr? ("WHEN"i expr "THEN"i expr)+ ("ELSE"i expr)? "END"i
literal: NUMBER | STRING | BLOB | "NULL"i | "TRUE"i | "FALSE"i | "CURRENT_DATE"i | "CURRENT_TIME"i | "CURRENT_TIMESTAMP"i
ident: IDENT | QUOTED | BACKTICK | BRACKET
NUMBER: /(?:0[xX][0-9a-fA-F]+|(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][+-]?[0-9]+)?)/
STRING: /'(?:[^']|'')*'/
BLOB: /[xX]'[0-9a-fA-F]*'/
QUOTED: /"(?:[^"]|"")*"/
BACKTICK: /`(?:[^`]|``)*`/
BRACKET: /\[[^\]]*\]/
IDENT: /__IDENT_PATTERN__/
%ignore /[ \t\r\n]+/
%ignore /--[^\r\n]*/
%ignore /\/\*([^*]|\*+[^*\/])*\*+\//
